# Docker Compose infrastructure
COMPOSE_PROJECT_NAME=erg-dev
ERG_HTTP_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_STATE_HOST_PORT=6379
REDIS_CACHE_HOST_PORT=6380
POSTGRES_DB=erg
POSTGRES_USER=erg
POSTGRES_PASSWORD=erg-local-password
POSTGRES_RUNTIME_USER=erg_app
POSTGRES_RUNTIME_PASSWORD=erg-local-runtime-password
POSTGRES_MAX_CONNECTIONS=100
REDIS_STATE_PASSWORD=erg-local-redis-state
REDIS_CACHE_PASSWORD=erg-local-redis-cache
REDIS_STATE_CONTAINER_MEMORY=1280m
REDIS_CACHE_CONTAINER_MEMORY=2560m

# Spring Boot process started from the Windows IDE
# The IDE process uses the local migration owner from the persistent dev volume.
# Native Docker/production runs use POSTGRES_RUNTIME_USER instead.
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=1606
APP__ENV=development
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/erg
SPRING_DATASOURCE_USERNAME=erg
SPRING_DATASOURCE_PASSWORD=erg-local-password
SPRING_FLYWAY_USER=erg
SPRING_FLYWAY_PASSWORD=erg-local-password
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=1
DB__MAX_OPEN_CONNS=10
DB__MAX_IDLE_CONNS=2
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# Keep MongoDB optional, but enable Redis for cache/session/health locally.
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.mongodb.autoconfigure.MongoAutoConfiguration,org.springframework.boot.data.mongodb.autoconfigure.DataMongoAutoConfiguration,org.springframework.boot.data.mongodb.autoconfigure.DataMongoRepositoriesAutoConfiguration
SPRING_DATA_REDIS_URL=redis://:erg-local-redis-state@127.0.0.1:6379
ERG_REDIS_STATE_ENABLED=true
ERG_REDIS_STATE_URL=redis://:erg-local-redis-state@127.0.0.1:6379
ERG_REDIS_CACHE_ENABLED=true
ERG_REDIS_CACHE_URL=redis://:erg-local-redis-cache@127.0.0.1:6380
ERG_REDIS_CACHE_L2_NAMES=organizationEducationUnits,lcmsSchoolDirectory,quizRuntimePackage,lcmsQuestionBankWorkspace,lcmsQuizWorkspace,lmsStudentGroups,lmsAssignmentProgress,lmsClassWorkspace,lmsHomeworkWorkspace,studentDashboard,quizQuestionAnalytics,quizAssignmentReport,calendarWorkspace
SPRING_DATA_REDIS_DATABASE=0
MANAGEMENT_HEALTH_REDIS_ENABLED=true

# HTTP and observability
HTTP__HOST=0.0.0.0
HTTP__PORT=1606
HTTP__CORS__ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3003,http://127.0.0.1:3003
HTTP__CORS__ALLOW_CREDENTIALS=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
ROOT_LOG_LEVEL=INFO
LOGGING__LEVEL=DEBUG

# Authentication - local-only values, replace outside local development.
SECRET_AUTH__JWT_SECRET=local-only-jwt-secret-change-before-production-0123456789

# Background processing
ERG_PROCESS_LOCAL_ENABLED=true
ERG_OUTBOX_WORKER_ENABLED=true
ERG_REPORTING_WORKER_ENABLED=true
NOTIFICATIONS__WORKER__ENABLED=true
NOTIFICATIONS__PUSH__ENABLED=false

# Optional integrations
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS_ENABLED=false
SECRET_SMTP__PASSWORD=
FIREBASE_CREDENTIALS_MODE=adc
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATIONS__PUSH__REGISTRATION_TOKEN_ENCRYPTION_KEY=
R2__ENDPOINT=
SECRET_R2__ACCESS_KEY_ID=
SECRET_R2__SECRET_KEY=
R2__BUCKET_NAME=erg
R2__PUBLIC_DOMAIN=

# Startup data is opt-in.
LIFECYCLE__LMS_SEED_ON_STARTUP=false
LIFECYCLE__QUESTION_BANK_SEED_ON_STARTUP=false
LIFECYCLE__SCHOOL_OPERATIONS_SEED_ON_STARTUP=false

    {
      "id": 10,
      "type": "logs",
      "title": "Request chậm hơn 1 giây (log backend)",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=\"backend\"} |= \"ApiAccessLogFilter\" | regexp \"api (?P<method>\\\\S+) (?P<path>\\\\S+) -> (?P<status>\\\\d+) \\\\((?P<ms>\\\\d+) ms\\\\)\" | ms > 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "description": "Mỗi dòng có requestId, userId và IP. Dán requestId vào dashboard «Log» để xem toàn bộ đường đi của request."
    },

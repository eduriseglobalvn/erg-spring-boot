          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{uri=~\"$uri\",status=~\"4..\"}[$__range])) / sum by (method, uri) (rate(http_server_requests_seconds_count{uri=~\"$uri\"}[$__range]))",
          "refId": "G",

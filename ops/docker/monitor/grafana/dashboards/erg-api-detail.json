          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{uri=~\"$uri\",status=~\"5..\"}[$__range])) / sum by (method, uri) (rate(http_server_requests_seconds_count{uri=~\"$uri\"}[$__range]))",
          "refId": "F",
          "instant": true,
          "format": "table"
        },

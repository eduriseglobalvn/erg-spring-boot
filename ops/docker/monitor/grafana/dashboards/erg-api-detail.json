      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "topk(10, sum by (method, uri) (rate(http_server_requests_seconds_count{uri=~\"$uri\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{method}} {{uri}}"
        }

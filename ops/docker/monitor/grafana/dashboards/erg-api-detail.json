        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=~\"$uri\",status=~\"4..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{uri=~\"$uri\"}[5m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "decimals": 2,
          "noValue": "chưa có dữ liệu",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Sai mật khẩu, hết phiên, thiếu quyền. Tăng đột ngột thường là lỗi frontend hoặc bị dò mật khẩu."
    },
    {

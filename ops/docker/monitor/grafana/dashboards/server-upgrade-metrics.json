{
  "title": "ERG Server Upgrade & Operations (i5-7500 / 16GB RAM)",
  "uid": "erg-server-upgrade",
  "schemaVersion": 39,
  "refresh": "10s",
  "tags": ["erg", "operations", "capacity-planning", "upgrade"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Utilization (%) [Upgrade if >80% sustained]",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Available RAM (MB) [Upgrade if <1500MB]",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes / 1024 / 1024"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 16384,
          "unit": "mbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 1500},
              {"color": "green", "value": 3000}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "NVMe SSD Free Space (%) [Alert if <15%]",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 15},
              {"color": "green", "value": 30}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Disk I/O Utilization (%) [SSD Stress]",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total[5m]) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "Total RPS"
        },
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors ({{status}})"
        },
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Client Errors ({{status}})"
        }
      ]
    },
    {
      "id": 6,
      "title": "REST Response Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "P99 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "title": "HikariCP DB Connection Pool (Active vs Pending)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 13},
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "Pending Queue (saturation)"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "Idle Connections"
        }
      ]
    },
    {
      "id": 8,
      "title": "PostgreSQL Active Connections vs Max (100)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 13},
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "PostgreSQL Active Backends"
        }
      ]
    },
    {
      "id": 9,
      "title": "Redis Memory & Hit Rate",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 13},
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Redis Memory MB ({{instance}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes"
        }
      }
    },
    {
      "id": 10,
      "title": "Application & System Logs (Loki Live Stream)",
      "type": "logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "Loki"},
          "expr": "{container=~\"erg-.*|backend.*\"} !~ \"actuator/prometheus\""
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}

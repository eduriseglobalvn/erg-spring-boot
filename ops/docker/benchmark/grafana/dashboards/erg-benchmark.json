{
  "title": "ERG JVM vs Native Benchmark",
  "uid": "erg-benchmark",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "tags": ["erg", "benchmark", "jvm", "native"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "k6 p95 latency", "targets": [{"expr": "k6_http_req_duration_p95"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "k6 request failures", "targets": [{"expr": "rate(k6_http_reqs_total{expected_response=\"false\"}[1m])"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "Container CPU", "targets": [{"expr": "rate(container_cpu_usage_seconds_total{name=~\"erg-benchmark.*\"}[1m])"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}},
    {"id": 4, "type": "timeseries", "title": "Container RSS", "targets": [{"expr": "container_memory_rss{name=~\"erg-benchmark.*\"}"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},
    {"id": 5, "type": "timeseries", "title": "Hikari pending", "targets": [{"expr": "hikaricp_connections_pending"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}},
    {"id": 6, "type": "timeseries", "title": "JVM heap and GC", "targets": [{"expr": "jvm_memory_used_bytes{area=\"heap\"}"}, {"expr": "rate(jvm_gc_pause_seconds_sum[1m])"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},
    {"id": 7, "type": "timeseries", "title": "PostgreSQL connections", "targets": [{"expr": "pg_stat_activity_count"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}},
    {"id": 8, "type": "timeseries", "title": "Redis memory and evictions", "targets": [{"expr": "redis_memory_used_bytes"}, {"expr": "rate(redis_evicted_keys_total[1m])"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}},
    {"id": 9, "type": "timeseries", "title": "Throughput", "targets": [{"expr": "rate(k6_http_reqs_total[1m])"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}}
  ]
}

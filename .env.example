APP__HOST=0.0.0.0
APP__PORT=8080
APP__ENV=development

HTTP__HOST=0.0.0.0
HTTP__PORT=8080
HTTP__CORS__ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3003,http://127.0.0.1:3003,http://erg.edu.local:3000,http://admin.erg.edu.local:3000,http://erg.edu.local:3001,http://hoclieu.erg.edu.local:3001,http://lcms.erg.edu.local:3001,http://lms.erg.edu.local:3001,http://elearning.erg.edu.local:3001,http://admin.erg.edu.local:3001,http://crm.erg.edu.vn:3001,http://lcms.erg.edu.vn:3001,http://lms.erg.edu.vn:3001,http://elearning.erg.edu.vn:3001,https://crm.erg.edu.vn:3001,https://lcms.erg.edu.vn:3001,https://lms.erg.edu.vn:3001,https://elearning.erg.edu.vn:3001
HTTP__CORS__ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
HTTP__CORS__ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Tenant-ID,X-Request-ID,X-Trace-ID,X-Idempotency-Key,X-Portal
HTTP__CORS__EXPOSED_HEADERS=X-Request-ID,X-Trace-ID,Deprecation,Sunset,Link,X-ERG-API-Owner
HTTP__CORS__ALLOW_CREDENTIALS=true
HTTP__CORS__MAX_AGE=86400

# Primary PostgreSQL DB (DB1). Required for every JPA-backed domain.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-host:5432/erg?sslmode=disable
# The application must connect as the restricted runtime role (NOSUPERUSER, NOBYPASSRLS, owns no
# tables) so tenant RLS applies; the prod profile refuses to start otherwise (RuntimeDatabaseRoleGuard).
# Flyway and the reset scripts use the schema owner through SPRING_FLYWAY_USER/SPRING_FLYWAY_PASSWORD.
SPRING_DATASOURCE_USERNAME=erg_app
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_USER=erg
SPRING_FLYWAY_PASSWORD=
# Prod never baselines a schema without flyway_schema_history; set true only for a one-time,
# approved legacy onboarding run, then remove it.
ERG_FLYWAY_ALLOW_BASELINE_ON_MIGRATE=false
# true only for the first deploy of a brand-new prod database (V125 removes the demo seed rows).
ERG_FLYWAY_DEMO_PURGE=false
DB__MAX_OPEN_CONNS=25
DB__MAX_IDLE_CONNS=5

MONGODB__URI=mongodb://localhost:27017
MONGODB__DATABASE=erg
MONGODB__AUTH_SOURCE=admin

REDIS__DB=0
REDIS__DIAL_TIMEOUT=5s
REDIS__READ_TIMEOUT=3s
REDIS__POOL_SIZE=10
REDIS__MIN_IDLE_CONNS=5

AUTH__JWT_ISSUER=erg-server
AUTH__JWT_ALGORITHMS=HS256
AUTH__ACCESS_TOKEN_TTL=3h
AUTH__MAX_FAILED_LOGIN=5
AUTH__FAILED_LOGIN_WINDOW=15m
AUTH__BLOCK_DURATION=15m
AUTH__GEO_BLOCK_ENABLED=true
AUTH__BLOCK_UNKNOWN_GEO=false
AUTH__ALLOWED_CONTINENTS=AS
AUTH__COOKIE__ENABLED=true
AUTH__COOKIE__DOMAIN=
AUTH__COOKIE__SECURE=false
AUTH__COOKIE__SAME_SITE=lax
SECRET_AUTH__JWT_SECRET=replace-with-strong-random-secret-min-32-chars
SECRET_AUTH__JWT_REFRESH_SECRET=replace-with-different-strong-random-secret-min-32-chars
SECRET_MEDIA_URL_SIGNING_KEY=replace-with-different-strong-random-secret-min-32-chars

SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USERNAME=your-email@example.com
SMTP__PASSWORD=
SECRET_SMTP__PASSWORD=
SMTP__FROM=noreply@erg.edu.vn

R2__ENDPOINT=
R2__ACCESS_KEY_ID=
SECRET_R2__ACCESS_KEY_ID=
R2__SECRET_KEY=
SECRET_R2__SECRET_KEY=
R2__BUCKET_NAME=erg
R2__PUBLIC_DOMAIN=
R2__REGION=auto

LOGGING__LEVEL=debug

TENANT__ENABLED=false
TENANT__DEFAULT_ID=default

LIFECYCLE__LMS_SEED_ON_STARTUP=false

        {
          "name": "POST - auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}",
                "type": "text"
              },
              {
                "key": "X-Request-ID",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "query": [],
              "variable": []
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"Password@123\",\n  \"deviceId\": \"postman-device\",\n  \"deviceName\": \"Postman\",\n  \"deviceFingerprint\": \"postman-local\",\n  \"rememberMe\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "if (data.accessToken) pm.environment.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },

type ElearningQuery {
  namespace: String!
  status: String!
  studentDashboard(input: StudentDashboardInput): StudentDashboard!
  discussionFeed(input: StudentDiscussionFeedInput): StudentDiscussionFeed!
  discussionModerationClasses(tenantId: String): [StudentDiscussionModerationClass!]!
  discussionModerationFeed(input: StudentDiscussionModerationFeedInput!): StudentDiscussionFeed!
  studentClassLeaderboard(input: StudentClassLeaderboardInput): ClassLeaderboard!
  leaderboardClasses(tenantId: String): [LeaderboardClass!]!
  classLeaderboard(input: ClassLeaderboardInput!): ClassLeaderboard!
}

input StudentClassLeaderboardInput { tenantId: String, classId: String }
input ClassLeaderboardInput { tenantId: String, classId: String! }

"""enabled = false for a student: the teacher switched the leaderboard off, entries are empty."""
type ClassLeaderboard { classId: String!, className: String, enabled: Boolean!, entries: [ClassLeaderboardEntry!]! }
"""rank and averagePercent are null for a student with no handed-in work (listed last)."""
type ClassLeaderboardEntry { rank: Int, studentId: String!, studentName: String, averagePercent: Float, completedCount: Int!, isViewer: Boolean! }
type LeaderboardClass { id: String!, name: String, leaderboardEnabled: Boolean! }

input StudentDashboardInput {
  tenantId: String
  studentUserId: String
  classId: String
}

type StudentDashboard {
  tenantId: String!
  viewer: StudentDashboardViewer!
  profile: StudentDashboardProfile!
  summary: StudentDashboardSummary!
  courses: [StudentDashboardCourseCard!]!
  assignments: [StudentDashboardAssignmentCard!]!
  nextActions: [StudentDashboardNextAction!]!
  announcements: [StudentDashboardAnnouncementCard!]!
  selectedClassId: String
  classes: [StudentDashboardClassMembership!]!
}

type StudentDashboardClassMembership {
  classId: String!
  className: String!
  schoolId: String
  gradeLabel: String
  academicYear: String
  status: String!
}

type StudentDashboardViewer {
  userId: String!
  tenantId: String!
  accountType: String
  accessLevel: String
}

type StudentDashboardProfile {
  userId: String!
  studentId: String
  studentCode: String
  fullName: String
  email: String
  schoolId: String
  academicClassId: String
  status: String
  updatedAt: String
  leaderboardEnabled: Boolean!
}

type StudentDashboardSummary {
  enrolledCourseCount: Int!
  activeAssignmentCount: Int!
  pendingActionCount: Int!
  scoreSummary: StudentDashboardScoreSummary!
  generatedAt: String!
}

type StudentDashboardScoreSummary {
  completedAttemptCount: Int!
  attemptedAssignmentCount: Int!
  passedAttemptCount: Int!
  averagePercent: Int!
  bestPercent: Int!
}

type StudentDashboardCourseCard {
  id: String!
  title: String!
  status: String
  progressPercent: Int!
  updatedAt: String
}

type StudentDashboardAssignmentCard {
  id: String!
  quizId: String
  title: String!
  status: String
  dueAt: String
  "Latest handed-in attempt, 0-100; null until one is handed in"
  scorePercent: Float
  submittedAt: String
}

type StudentDashboardNextAction {
  id: String!
  kind: String!
  label: String!
  targetId: String
  dueAt: String
}

type StudentDashboardAnnouncementCard {
  id: String!
  title: String!
  content: String
  pinned: Boolean!
  publishedAt: String
  updatedAt: String
}

input LearningResourceLibraryInput {

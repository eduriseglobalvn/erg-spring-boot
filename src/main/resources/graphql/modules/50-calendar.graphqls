type TeachingScheduleRowMessage { code: String!, field: String, message: String! }
type TeachingScheduleConflict { code: String!, severity: String!, clientRowId: String, existingEventId: String, message: String! }

# --- Lich day v2 (KE_HOACH_LICH_DAY.md muc 4.2). Date = yyyy-MM-dd, DateTime = ISO-8601 offset date-time. ---
scalar Date
scalar DateTime

enum TeachingScheduleConflictKind { TEACHER_TIME CLASS_TIME ROOM_TIME TRAVEL_TIME TEACHER_ON_LEAVE }
enum TeachingScheduleSeverity { ERROR WARNING }
enum TeachingSession { MORNING AFTERNOON EVENING }
enum TeachingScheduleFixKind { CHANGE_TEACHER CHANGE_ROOM CHANGE_PREVIOUS_TEACHER }
enum TeachingAccessState { EXISTING NEW REVOKE }
enum TeachingSlotOptionState { SUGGESTED FREE BUSY TRAVEL LEAVE }
enum TeachingScheduleRole { MAIN ASSISTANT }

type TeachingScheduleBatch { id: ID!, schoolId: ID!, label: String!, status: TeachingScheduleStatus!, version: Int!, periodTemplateId: ID, applyFrom: Date, repeatWeeks: Int, publishedAt: DateTime, affectedEventCount: Int! }

type TeachingPeriodSlot { periodNo: Int!, session: TeachingSession!, startTime: String, endTime: String }
type TeachingPeriodTemplate { id: ID!, name: String!, periodsPerDay: Int!, slots: [TeachingPeriodSlot!]! }
# One dated table of a school ("Áp dụng từ 01/11/2026"); effectiveFrom is null for the table that predates dating.
type SchoolPeriodAssignment { schoolId: ID!, schoolName: String!, templateId: ID!, templateName: String!, effectiveFrom: Date, current: Boolean! }

enum TeachingScheduleTeacherRole { MAIN ASSISTANT }
enum TeachingCalendarViewMode { ALL BY_SCHOOL BY_TEACHER BY_SUBJECT }
enum TeachingScheduleStatus { DRAFT PUBLISHED CANCELLED }


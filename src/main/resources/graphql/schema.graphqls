type TeachingCalendarWorkspace { tenantId: String!, from: String!, to: String!, viewMode: TeachingCalendarViewMode!, events: [TeachingCalendarEvent!]!, filterOptions: TeachingCalendarFilterOptions!, laneSummaries: [TeachingCalendarLaneSummary!]!, catalog: TeachingScheduleCatalog!, permissions: TeachingCalendarPermissions!, generatedAt: String! }
type TeachingCalendarEvent { id: String!, batchId: String, title: String!, startAt: String!, endAt: String!, date: String!, startTime: String!, endTime: String!, schoolId: String!, schoolName: String!, classId: String!, className: String!, subjectId: String, subjectName: String, levelId: String, levelName: String, roomId: String, roomName: String, periodStart: Int!, periodCount: Int!, teachers: [TeachingScheduleTeacherAssignment!]!, status: TeachingScheduleStatus!, note: String, colorGroup: TeachingCalendarColorGroup! }
type TeachingScheduleTeacherAssignment { userId: String!, displayName: String!, role: TeachingScheduleTeacherRole!, colorKey: String }
type TeachingCalendarFilterOptions { schools: [TeachingCalendarFilterOption!]!, classes: [TeachingCalendarFilterOption!]!, teachers: [TeachingCalendarFilterOption!]!, subjects: [TeachingCalendarFilterOption!]!, levels: [TeachingCalendarFilterOption!]! }
type TeachingCalendarFilterOption { id: String!, label: String!, count: Int!, colorKey: String }
type TeachingCalendarLaneSummary { id: String!, label: String!, count: Int!, colorKey: String }
type TeachingCalendarColorGroup { key: String!, label: String!, kind: String! }
type TeachingScheduleCatalog { schools: [TeachingCalendarFilterOption!]!, classes: [TeachingCalendarClassOption!]!, teachers: [TeachingCalendarTeacherOption!]!, assistantTeachers: [TeachingCalendarTeacherOption!]!, subjects: [TeachingCalendarSubjectOption!]!, levels: [TeachingCalendarLevelOption!]!, rooms: [TeachingCalendarRoomOption!]! }

extend type Mutation {
  createLearningPath(input: CreateLearningPathInput!): LearningPath!
  publishLearningPath(input: PublishLearningPathInput!): LearningPath!
  addLearningPathNode(input: AddLearningPathNodeInput!): LearningPathNode!
  createCompetency(input: CreateCompetencyInput!): Competency!
  recordCompetencyAttainment(input: RecordCompetencyAttainmentInput!): CompetencyAttainment!
  evaluateLearningPathCompletion(input: EvaluateCompletionInput!): LearningPathCompletion!
  issueOutcomeCertificate(input: IssueOutcomeCertificateInput!): OutcomeCertificate!
  revokeOutcomeCertificate(input: RevokeOutcomeCertificateInput!): OutcomeCertificate!
}

input LearningOutcomesQueryInput { tenantId: String, educationUnitId: String, classId: String, status: String, learnerId: String }
type LearningOutcomesWorkspace {
  paths: [LearningPath!]!
  competencies: [Competency!]!
  completions: [LearningPathCompletion!]!
  attainments: [CompetencyAttainment!]!
  certificates: [OutcomeCertificate!]!
}
type LearningPath { id: String!, tenantId: String!, title: String!, description: String, status: String!, educationUnitId: String, classId: String, recordVersion: Int!, nodeCount: Int!, createdAt: String, updatedAt: String }
type LearningPathNode { id: String!, tenantId: String!, pathId: String!, contentRefId: String!, contentKind: String!, sortOrder: Int!, required: Boolean!, createdAt: String }
type LearningPathDetail { path: LearningPath!, nodes: [LearningPathNode!]! }
type Competency { id: String!, tenantId: String!, code: String!, name: String!, description: String, status: String!, educationUnitId: String, recordVersion: Int!, createdAt: String, updatedAt: String }
type CompetencyAttainment { id: String!, tenantId: String!, learnerId: String!, competencyId: String!, learningPathId: String, classId: String, status: String!, evidenceRef: String!, achievedAt: String, recordVersion: Int!, progressPercent: Int! }
type LearningPathCompletion { id: String!, tenantId: String!, learnerId: String!, learningPathId: String!, status: String!, requiredNodeCount: Int!, completedNodeCount: Int!, progressPercent: Int!, evidenceRef: String!, evaluatedAt: String, recordVersion: Int! }
type OutcomeCertificate { id: String!, tenantId: String!, learnerId: String!, learningPathId: String!, certificateNumber: String!, verificationId: String!, status: String!, evidenceRef: String!, issuedAt: String, expiresAt: String, revokedAt: String, recordVersion: Int!, revokedBy: String, revocationReason: String }

input CreateLearningPathInput { tenantId: String, title: String!, description: String, educationUnitId: String, classId: String, idempotencyKey: String! }
input PublishLearningPathInput { pathId: String!, expectedVersion: Int!, idempotencyKey: String! }
input AddLearningPathNodeInput { pathId: String!, contentRefId: String!, contentKind: String!, sortOrder: Int!, required: Boolean!, expectedPathVersion: Int!, idempotencyKey: String! }
input CreateCompetencyInput { tenantId: String, code: String!, name: String!, description: String, educationUnitId: String, idempotencyKey: String! }
input RecordCompetencyAttainmentInput { learnerId: String!, competencyId: String!, learningPathId: String, classId: String, evidenceRef: String!, progressPercent: Int, idempotencyKey: String! }
input EvaluateCompletionInput { learnerId: String!, learningPathId: String!, expectedVersion: Int!, completedContentRefIds: [String!]!, evidenceRef: String!, idempotencyKey: String! }
input IssueOutcomeCertificateInput { learnerId: String!, learningPathId: String!, certificateNumber: String!, evidenceRef: String!, expiresAt: String, idempotencyKey: String! }
input RevokeOutcomeCertificateInput { certificateId: String!, expectedVersion: Int!, reason: String!, idempotencyKey: String! }

type Mutation {
  upsertAttendance(input: UpsertAttendanceInput!): AttendanceRecord!
  upsertGradebookScore(input: UpsertGradebookScoreInput!): GradebookScore!
  "Clears one cell: the student has no score in that column any more"
  deleteGradebookScore(input: DeleteGradebookScoreInput!): Boolean!
  createStudentDiscussion(input: CreateStudentDiscussionInput!): StudentDiscussionPost!
  replyStudentDiscussion(input: ReplyStudentDiscussionInput!): StudentDiscussionComment!
  setStudentDiscussionReaction(input: SetStudentDiscussionReactionInput!): StudentDiscussionReactionPayload!
  markStudentAnnouncementRead(input: MarkStudentAnnouncementReadInput!): StudentAnnouncementReadPayload!
  setStudentDiscussionHidden(input: SetStudentDiscussionHiddenInput!): StudentDiscussionModerationPayload!
  deleteStudentDiscussionItem(input: DeleteStudentDiscussionItemInput!): StudentDiscussionModerationPayload!
  "Follow (true) or unfollow a thread of the student's class; followers are notified of new replies"
  followStudentDiscussion(input: FollowStudentDiscussionInput!): Boolean!
  "Teacher or admin pins a thread to the top of the class list"
  setStudentDiscussionPinned(input: SetStudentDiscussionPinnedInput!): StudentDiscussionPost!
  "Teacher or admin chooses a reply as the answer; commentId null clears the choice"
  acceptStudentDiscussionReply(input: AcceptStudentDiscussionReplyInput!): StudentDiscussionPost!
  askTeacherAboutQuestion(input: AskTeacherAboutQuestionInput!): QuestionThread!
  sendQuestionThreadMessage(input: SendQuestionThreadMessageInput!): QuestionThread!
  "Student: marks one of their own question threads as read (clears QuestionThread.unread until the teacher writes again)"
  markStudentQuestionThreadRead(threadId: ID!, tenantId: String): Boolean!
  "Teacher or admin answers; the thread becomes ANSWERED"
  answerQuestionThread(input: SendQuestionThreadMessageInput!): QuestionThread!
  setClassLeaderboardEnabled(input: SetClassLeaderboardEnabledInput!): LeaderboardClass!
  setMyLeaderboardHidden(input: SetMyLeaderboardHiddenInput!): Boolean!
  "tierKey null = no frame; a frame that is not unlocked is rejected"
  selectFrame(tierKey: String, tenantId: String): MyFrames!
  acknowledgeTierPromotion(weekStart: String!, tenantId: String): Boolean!
  "Admin: runs the weekly tier update now for the caller's tenant; returns the number of students tiered. Safe to repeat."
  runStudentTierUpdate(tenantId: String): Int!
  previewTeachingSchedule(input: TeachingScheduleBulkInput!): TeachingSchedulePreviewPayload!
  createTeachingSchedule(input: TeachingScheduleBulkInput!): TeachingScheduleBulkPayload!
  updateTeachingScheduleEvent(input: TeachingScheduleEventUpdateInput!): TeachingScheduleEventPayload!
  deleteTeachingScheduleEvent(input: TeachingScheduleEventDeleteInput!): TeachingScheduleDeletePayload!
  deleteTeacherSchedule(input: DeleteTeacherScheduleInput!): TeachingScheduleDeletePayload!
  saveTeachingScheduleDraft(input: SaveTeachingScheduleDraftInput!): TeachingScheduleDraftResult!
  publishTeachingScheduleBatch(batchId: ID!, expectedVersion: Int!): TeachingScheduleBatch!
  cancelTeachingScheduleBatch(batchId: ID!, expectedVersion: Int!): TeachingScheduleBatch!
  renameTeachingScheduleBatch(batchId: ID!, label: String!, expectedVersion: Int!): TeachingScheduleBatch!
  updateTeachingScheduleLoadSettings(loadWarn: Int!, loadMax: Int!): TeachingScheduleLoadSettings!
  reuseTeachingScheduleWeek(input: TeachingScheduleReuseInput!): TeachingScheduleDraftResult!
  editTeachingScheduleSlot(input: EditTeachingScheduleSlotInput!): TeachingScheduleSlotChangeResult!
  swapTeachingScheduleTeacher(input: SwapTeachingScheduleTeacherInput!): TeachingScheduleSlotChangeResult!
  saveTeachingPeriodTemplate(input: SaveTeachingPeriodTemplateInput!): TeachingPeriodTemplate!
  assignSchoolPeriodTemplate(schoolId: ID!, templateId: ID!, effectiveFrom: Date!): SchoolPeriodAssignment!
  saveSchoolPeriodTimes(input: SaveSchoolPeriodTimesInput!): SchoolPeriodAssignment!
  upsertSchoolTravelTime(schoolAId: ID!, schoolBId: ID!, minutes: Int!): SchoolTravelTime!
  deleteSchoolTravelTime(schoolAId: ID!, schoolBId: ID!): Boolean!
  createRoom(input: CreateRoomInput!): TeachingScheduleRoomOption!
}

input AttendanceWorkspaceInput { tenantId: String, classId: String!, schoolId: String, subjectId: String!, from: String, to: String }
input GradebookWorkspaceInput { tenantId: String, classId: String!, schoolId: String, subjectId: String! }
input UpsertAttendanceInput { tenantId: String, classId: String!, schoolId: String, studentId: String!, subjectId: String!, attendanceDate: String!, lessonIndex: Int!, status: String!, expectedVersion: Int, operationId: String, idempotencyKey: String }
input DeleteGradebookScoreInput { tenantId: String, classId: String!, studentId: String!, subjectId: String!, columnId: String! }
input UpsertGradebookScoreInput { tenantId: String, classId: String!, schoolId: String, studentId: String!, subjectId: String!, columnId: String!, label: String!, maxScore: Float!, kind: String!, position: Int, score: Float!, expectedVersion: Int, operationId: String, idempotencyKey: String }

type AttendanceWorkspace { tenantId: String!, classId: String!, subjectId: String!, from: String!, to: String!, records: [AttendanceRecord!]! }
type AttendanceRecord { id: String!, studentId: String!, subjectId: String!, attendanceDate: String!, lessonIndex: Int!, status: String!, version: Int!, updatedAt: String! }
type GradebookWorkspace { tenantId: String!, classId: String!, subjectId: String!, columns: [GradebookColumn!]!, scores: [GradebookScore!]! }
type GradebookColumn { id: String!, label: String!, maxScore: Float!, kind: String!, position: Int!, version: Int!, updatedAt: String! }
type GradebookScore { studentId: String!, columnId: String!, score: Float!, maxScore: Float!, version: Int!, updatedAt: String! }

"""filter: ALL (default), UNANSWERED (no reply yet) or MINE. subject narrows by the subject chip."""
input StudentDiscussionFeedInput { tenantId: String, page: Int, size: Int, filter: String, subject: String }
input CreateStudentDiscussionInput { tenantId: String, idempotencyKey: String!, title: String!, content: String!, assignmentId: String, attachmentIds: [String!], subject: String }
input ReplyStudentDiscussionInput { tenantId: String, idempotencyKey: String!, postId: String!, parentCommentId: String, content: String!, attachmentIds: [String!] }
input SetStudentDiscussionReactionInput { tenantId: String, targetType: String!, targetId: String!, reaction: String! }
input MarkStudentAnnouncementReadInput { tenantId: String, announcementId: String! }
input StudentDiscussionModerationFeedInput { tenantId: String, classId: String!, page: Int, size: Int }
input SetStudentDiscussionHiddenInput { tenantId: String, targetType: String!, targetId: String!, hidden: Boolean! }
input SetClassLeaderboardEnabledInput { tenantId: String, classId: String!, enabled: Boolean! }
input SetMyLeaderboardHiddenInput { tenantId: String, hidden: Boolean! }
input DeleteStudentDiscussionItemInput { tenantId: String, targetType: String!, targetId: String! }
input FollowStudentDiscussionInput { tenantId: String, postId: String!, follow: Boolean! }
input SetStudentDiscussionPinnedInput { tenantId: String, postId: String!, pinned: Boolean! }
input AcceptStudentDiscussionReplyInput { tenantId: String, postId: String!, commentId: String }
"""questionIndex is 1-based. questionPrompt and studentAnswerText are what the student saw; the correct answer is added server-side."""
input AskTeacherAboutQuestionInput { tenantId: String, idempotencyKey: String!, assignmentId: String!, questionIndex: Int!, questionPrompt: String, studentAnswerText: String, message: String!, attachmentIds: [String!] }
input SendQuestionThreadMessageInput { tenantId: String, threadId: String!, message: String!, attachmentIds: [String!] }

type StudentDiscussionFeed { items: [StudentDiscussionPost!]!, page: Int!, size: Int!, totalItems: Int!, hasNext: Boolean! }
"""One page of a post's comments (or of the replies of one top-level comment)."""
type StudentDiscussionCommentPage { items: [StudentDiscussionComment!]!, page: Int!, size: Int!, totalItems: Int!, hasNext: Boolean! }
type StudentDiscussionPost { id: String!, authorId: String, authorName: String, authorInitials: String, academicClassId: String, className: String, title: String, content: String, createdAt: String, attachmentIds: [String!]!, assignmentId: String, reactions: [StudentDiscussionReactionCount!]!, viewerReaction: String, comments: [StudentDiscussionComment!]!, hidden: Boolean!, subject: String, pinned: Boolean!, "The reply the teacher chose as the answer" acceptedReplyId: String, "The viewer follows this thread" following: Boolean!, "Visible comments and replies of the post (hidden ones only count for moderators)" commentCount: Int!, "More top-level comments exist than the comments list holds; page them with discussionComments" hasMoreComments: Boolean! }
type StudentDiscussionComment { id: String!, parentId: String, authorId: String, authorName: String, authorInitials: String, content: String, createdAt: String, attachmentIds: [String!]!, reactions: [StudentDiscussionReactionCount!]!, viewerReaction: String, replies: [StudentDiscussionComment!]!, hidden: Boolean!, "Visible replies of this comment" replyCount: Int!, "More replies exist than the replies list holds; page them with discussionComments(parentId)" hasMoreReplies: Boolean! }
type StudentDiscussionReactionCount { reaction: String!, count: Int! }
type StudentDiscussionReactionPayload { targetType: String!, targetId: String!, viewerReaction: String, reactions: [StudentDiscussionReactionCount!]! }
type StudentDiscussionModerationClass { id: String!, name: String }
type StudentDiscussionModerationPayload { targetType: String!, targetId: String!, hidden: Boolean!, deleted: Boolean! }
"""status: OPEN or ANSWERED. correctAnswerText is null unless the quiz lets students see answers and they handed in (teachers always get it)."""
type QuestionThread { id: String!, assignmentId: String!, assignmentTitle: String, subjectName: String, className: String, questionIndex: Int!, questionPrompt: String, studentAnswerText: String, correctAnswerText: String, teacherId: String, teacherName: String, studentName: String, status: String!, lastMessageAt: String, lastMessagePreview: String, "Empty in lists; filled by the detail queries and the mutations" messages: [QuestionMessage!]!, "Student view: a teacher message is newer than the last markStudentQuestionThreadRead; always false on the teacher side" unread: Boolean! }
type QuestionMessage { id: String!, senderId: String!, senderName: String, senderRole: String!, mine: Boolean!, body: String!, attachmentIds: [String!]!, createdAt: String! }
type StudentAnnouncementReadPayload { announcementId: String!, read: Boolean!, readAt: String! }


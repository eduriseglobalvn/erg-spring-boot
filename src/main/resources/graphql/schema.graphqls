type TeachingScheduleBulkPayload { batchId: String, createdEventCount: Int!, teacherScheduleCount: Int!, totalPeriodCount: Int!, rowResults: [TeachingScheduleRowResult!]!, conflicts: [TeachingScheduleConflict!]! }

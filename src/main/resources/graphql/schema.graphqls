type TeachingScheduleBatchDetail { id: String!, tenantId: String!, schoolId: String!, academicYear: String, applyFrom: String, repeatWeeks: Int!, status: TeachingScheduleStatus!, source: String, note: String, createdBy: String, publishedBy: String, publishedAt: String, createdAt: String, eventCount: Int! }

type Query {
  lms: LmsQuery!
  lcms: LcmsQuery!
  crm: PlatformNamespace!
  elearning: ElearningQuery!
}

type LmsQuery {
  namespace: String!
  status: String!
  learningResourceLibrary(input: LearningResourceLibraryInput): LearningResourceLibrary!
  classWorkspace(input: ClassWorkspaceInput!): ClassWorkspace!
  teacherHomeworkWorkspace(input: TeacherHomeworkWorkspaceInput): TeacherHomeworkWorkspace!
  assignmentProgressWorkspace(input: AssignmentProgressWorkspaceInput!): AssignmentProgressWorkspace!
  studentGroups(input: StudentGroupsInput): StudentGroupWorkspace!
  myTeachingCalendar(input: MyTeachingCalendarInput!): TeachingCalendarWorkspace!
  myStudentCalendar(input: MyStudentCalendarInput!): TeachingCalendarWorkspace!
  attendanceWorkspace(input: AttendanceWorkspaceInput!): AttendanceWorkspace!
  gradebookWorkspace(input: GradebookWorkspaceInput!): GradebookWorkspace!
}

type PlatformNamespace {
  namespace: String!
  status: String!
}

type LcmsQuery {
  namespace: String!
  status: String!
  questionBankWorkspace(input: QuestionBankWorkspaceInput): QuestionBankWorkspace!
  accessManagementWorkspace(input: AccessManagementWorkspaceInput): AccessManagementWorkspace!
  teachingCalendarWorkspace(input: TeachingCalendarWorkspaceInput!): TeachingCalendarWorkspace!
  teachingScheduleBatches(input: TeachingScheduleBatchListInput): TeachingScheduleBatchPage!
  teachingScheduleBatch(input: TeachingScheduleBatchDetailInput!): TeachingScheduleBatchDetail!
  teachingPeriodTemplates: [TeachingPeriodTemplate!]!
  schoolPeriodAssignments(schoolIds: [ID!]): [SchoolPeriodAssignment!]!
  teachingScheduleSlotOptions(schoolId: ID!, batchId: ID, date: Date!, periodNo: Int!, classId: ID, excludeEventId: ID): TeachingSlotOptions!
  teachingScheduleDraft(batchId: ID!): TeachingScheduleDraftResult!
  previewTeachingScheduleReuse(input: TeachingScheduleReuseInput!): TeachingScheduleReusePreview!
  teachingScheduleOverviewSchools(weekStart: Date!, search: String, quick: String, page: Int!, size: Int!): TeachingOverviewSchoolPage!
  teachingScheduleOverviewGrid(weekStart: Date!, schoolIds: [ID!]!): TeachingOverviewGrid!
  teachingScheduleOverviewTeachers(weekStart: Date!, search: String, quick: String, sort: String, page: Int!, size: Int!): TeachingOverviewTeacherPage!
  teachingScheduleLoadSettings: TeachingScheduleLoadSettings!
  teachingScheduleDayLoads(from: Date!, to: Date!): [TeachingDayLoad!]!
  schoolTravelTimes(search: String, page: Int!, size: Int!): [SchoolTravelTime!]!
  quizWorkspace(input: QuizWorkspaceInput): QuizWorkspace!
  quizDraft(quizId: String!): QuizDraftDocument!
  quizVersions(quizId: String!): QuizVersionHistory!
  quizQuestionAnalytics(quizVersionId: String!): QuizQuestionAnalytics!
  assignmentReport(assignmentId: String!, page: Int, size: Int): AssignmentReport!
  schoolDirectory(input: SchoolDirectoryInput): SchoolDirectoryWorkspace!
  schoolOperations(input: SchoolOperationsInput!): SchoolOperationsWorkspace!
  schoolStudents(input: SchoolStudentsInput!): SchoolStudentPage!
}

input SchoolDirectoryInput { tenantId: String, search: String, status: String, schoolType: String, page: Int, size: Int }
input SchoolOperationsInput { tenantId: String, schoolId: String! }
"""status: studying | at-risk | inactive. size: 1..200, default 20."""
input SchoolStudentsInput { tenantId: String, schoolId: String!, search: String, grade: String, className: String, status: String, page: Int, size: Int }

type SchoolDirectoryWorkspace {
  items: [SchoolDirectoryItem!]!
  page: Int!
  size: Int!
  totalItems: Int!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

type SchoolDirectoryItem {
  id: String!
  name: String!
  slug: String
  schoolType: String!
  status: String!
  district: String
  academicYear: String
  classCount: Int!
  studentCount: Int!
  version: String!
}

type SchoolOperationsWorkspace {
  school: SchoolOperationsProfile!
  summary: SchoolOperationsSummary!
  academicYears: [SchoolAcademicYear!]!
  grades: [SchoolGrade!]!
  classes: [SchoolClass!]!
  students: [SchoolStudent!]! @deprecated(reason: "Always empty; page students with schoolStudents.")
  subjects: [SchoolSubject!]!
  permissions: SchoolOperationsPermissions!
}

type SchoolOperationsProfile {
  id: String!
  name: String!
  slug: String
  schoolType: String!
  status: String!
  address: String
  district: String
  principalName: String
  contactPhone: String
  contactEmail: String
  currentAcademicYearId: String
  version: String!
}

type SchoolOperationsSummary { classCount: Int!, activeClassCount: Int!, studentCount: Int!, gradeCount: Int!, students: SchoolStudentStats!, scoredStudentCount: Int!, averageScore: Float }
type SchoolStudentStats { total: Int!, atRisk: Int!, studying: Int!, profileComplete: Int!, assigned: Int! }
type SchoolStudentPage { items: [SchoolStudent!]!, page: Int!, size: Int!, totalItems: Int!, totalPages: Int!, hasNext: Boolean!, hasPrevious: Boolean!, stats: SchoolStudentStats! }
type SchoolOperationsPermissions { canCreateSchool: Boolean!, canUpdateSchool: Boolean!, canArchiveSchool: Boolean!, canManageClasses: Boolean! }
type SchoolAcademicYear { id: String!, startYear: Int!, endYear: Int!, displayName: String!, status: String!, startsOn: String, endsOn: String, version: String! }
type SchoolGrade { id: String!, academicYearId: String!, gradeCode: String!, label: String!, sortOrder: Int!, status: String!, source: String! }
type SchoolClass { id: String!, name: String!, grade: String, homeroomTeacher: String, studentCount: Int!, status: String }
type SchoolStudent { id: String!, code: String, fullName: String!, birthDate: String, grade: String, className: String, guardianPhone: String, subjectIds: [String!]!, status: String!, averageScore: Float }
type SchoolSubject { id: String!, name: String!, code: String, studentCount: Int!, teacherCount: Int! }

type QuizQuestionAnalytics {
  quizVersionId: String!
  questions: [QuestionAnalyticsRow!]!
}

type QuestionAnalyticsRow {
  quizVersionQuestionId: String!
  questionKind: String
  answeredCount: Int!
  correctCount: Int!
  partialCount: Int!
  correctRate: Float!
  averageAwardedPoints: Float!
  maxPoints: Float!
}

type AssignmentReport {
  assignmentId: String!
  totalRecipients: Int!
  submittedCount: Int!
  inProgressCount: Int!
  notStartedCount: Int!
  needsReviewCount: Int!
  averagePercent: Float!
  students: [StudentProgressRow!]!
  page: Int!
  size: Int!
  totalPages: Int!
  hasNext: Boolean!
}

type StudentProgressRow {
  studentUserId: String!
  studentName: String
  status: String
  answeredCount: Int!
  totalQuestions: Int!
  percentComplete: Float
  score: Float
  passed: Boolean
  submittedAt: String
}

type QuizVersionHistory {
  quizId: String!
  items: [QuizVersionSummary!]!
}

type QuizVersionSummary {
  id: String!
  versionLabel: String!
  versionNumber: Int!
  gradingMode: String
  contentHash: String
  publishedBy: String
  publishedAt: String
  isActive: Boolean!
}

input QuizWorkspaceInput {
  tenantId: String
  search: String
  subjectId: String
  levelId: String
  categoryId: String
  status: String
  kind: String
  page: Int
  size: Int
}

type QuizWorkspace {
  tenantId: String!
  quizzes: QuizSummaryPage!
  subjects: [QuestionBankOption!]!
  levels: [QuestionBankOption!]!
  categories: [QuestionBankOption!]!
}

type QuizSummaryPage {
  items: [QuizSummary!]!
  page: Int!
  size: Int!
  totalItems: Int!
  totalPages: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

type QuizSummary {
  id: String!
  title: String!
  subtitle: String
  kind: String
  status: String
  subjectId: String
  levelId: String
  categoryId: String
  currentVersionLabel: String
  questionCount: Int!
  updatedAt: String
}

type QuizDraftDocument {
  quizId: String!
  draftId: String!
  docVersion: Int!
  baseVersionLabel: String
  updatedAt: String
  settings: String
  playerTemplate: String
  tree: String
}

type ElearningQuery {
  namespace: String!
  status: String!
  studentDashboard(input: StudentDashboardInput): StudentDashboard!
  discussionFeed(input: StudentDiscussionFeedInput): StudentDiscussionFeed!
  "Pages the comments of a post of the student's class (parentId: the replies of one top-level comment). Page 0 is the newest window the feed embeds; size is capped at 50; items of a page run oldest to newest, like the feed."
  discussionComments(postId: String!, parentId: String, page: Int = 0, size: Int = 20, tenantId: String): StudentDiscussionCommentPage!
  discussionModerationClasses(tenantId: String): [StudentDiscussionModerationClass!]!
  discussionModerationFeed(input: StudentDiscussionModerationFeedInput!): StudentDiscussionFeed!
  studentClassLeaderboard(input: StudentClassLeaderboardInput, viewerOnly: Boolean = false): ClassLeaderboard!
  leaderboardClasses(tenantId: String): [LeaderboardClass!]!
  classLeaderboard(input: ClassLeaderboardInput!): ClassLeaderboard!
  "Tier of the authenticated student; dates are yyyy-MM-dd strings"
  myTier(tenantId: String): MyTier!
  "Cutoffs of the student's own grade for weekStart (default: the latest update)"
  tierTable(weekStart: String, tenantId: String): [TierTableRow!]!
  myFrames(tenantId: String): MyFrames!
  "Hộp thư: the student's own threads about a question, newest first. status: OPEN or ANSWERED. includeCorrectAnswer: false skips the correct-answer lookup (correctAnswerText is then null)"
  myQuestionThreads(status: String, tenantId: String, includeCorrectAnswer: Boolean = true): [QuestionThread!]!
  questionThread(id: String!, tenantId: String): QuestionThread!
  "Threads addressed to the teacher (a tenant-wide admin sees every thread of the tenant)"
  teacherQuestionThreads(status: String, tenantId: String, includeCorrectAnswer: Boolean = true): [QuestionThread!]!
  teacherQuestionThread(id: String!, tenantId: String): QuestionThread!
}

type MyTier { tierKey: String, division: Int, gradeRank: Int, gradeSize: Int, courseXp: Int!, eligible: Boolean!, submittedCount: Int!, protected: Boolean!, nextDivision: TierStep, nextTier: TierStep, pendingPromotion: TierPromotion }
"""nextDivision: the next division of the same tier; nextTier: the entry division of the next tier. studentsToPass: grade ranks still to climb to get in."""
type TierStep { tierKey: String!, division: Int, minXp: Int!, studentsToPass: Int! }
type TierPromotion { weekStart: String!, fromKey: String!, fromDivision: Int, toKey: String!, toDivision: Int, studentsPassed: Int!, gradePercentile: Int! }
type TierTableRow { tierKey: String!, share: String!, seats: Int!, divisions: [TierCell!]! }
type TierCell { division: Int, rankFrom: Int!, rankTo: Int!, minXp: Int! }
type Frame { tierKey: String!, unlocked: Boolean!, unlockedAt: String, schoolYear: String, studentsToPass: Int }
"""selected: the frame worn (null = none)"""
type MyFrames { selected: String, frames: [Frame!]! }

"""period: WEEK (default), MONTH, TERM (teachers/admins) or COURSE (the school year, 1 Sep - 31 Aug). scope: CLASS (default) or GRADE."""
input StudentClassLeaderboardInput { tenantId: String, classId: String, period: String, scope: String }
input ClassLeaderboardInput { tenantId: String, classId: String!, period: String }

"""Ranked by XP only; scores are never returned. enabled = false for a student: the teacher switched the board off, entries are empty."""
type ClassLeaderboard { classId: String!, className: String, enabled: Boolean!, period: String!, scope: String!, periodEndsAt: String!, viewerHidden: Boolean!, entries: [ClassLeaderboardEntry!]!, "Only for the student board" me: LeaderboardMe }
"""rank is null with no XP in the period (listed last). rankChange > 0: moved up since the previous period."""
type ClassLeaderboardEntry { rank: Int, studentId: String!, studentName: String, xp: Int!, streakDays: Int!, rankChange: Int, isViewer: Boolean!, "Rank gained since yesterday (>0 = moved up); null when unranked yesterday" rankDelta: Int, submittedInPeriod: Int!, xpToday: Int!, "Tier of the student; null without a tier or when hidden from others" tierKey: String, division: Int, "Frame worn; null when none or hidden" frameKey: String, hidden: Boolean! }
"""rank/size in the requested scope (size = students listed); gradeRank/gradeSize in the whole grade; xpToNextRank: XP to pass the student above, null at rank 1"""
type LeaderboardMe { rank: Int, size: Int!, xp: Int!, gradeRank: Int, gradeSize: Int!, xpToNextRank: Int, nextRankName: String }
type LeaderboardClass { id: String!, name: String, leaderboardEnabled: Boolean! }

input StudentDashboardInput {
  tenantId: String
  studentUserId: String
  classId: String
  "How many assignments to return, oldest due first: default 50, at most 500"
  assignmentLimit: Int
}

type StudentDashboard {
  tenantId: String!
  viewer: StudentDashboardViewer!
  profile: StudentDashboardProfile!
  summary: StudentDashboardSummary!
  courses: [StudentDashboardCourseCard!]!
  assignments: [StudentDashboardAssignmentCard!]!
  nextActions: [StudentDashboardNextAction!]!
  announcements: [StudentDashboardAnnouncementCard!]!
  selectedClassId: String
  classes: [StudentDashboardClassMembership!]!
  "True when the student has more assignments than were returned (ask again with a larger assignmentLimit)"
  assignmentsHasMore: Boolean
}

type StudentDashboardClassMembership {
  classId: String!
  className: String!
  schoolId: String
  gradeLabel: String
  academicYear: String
  status: String!
}

type StudentDashboardViewer {
  userId: String!
  tenantId: String!
  accountType: String
  accessLevel: String
}

type StudentDashboardProfile {
  userId: String!
  studentId: String
  studentCode: String
  fullName: String
  email: String
  schoolId: String
  academicClassId: String
  status: String
  updatedAt: String
  leaderboardEnabled: Boolean!
}

type StudentDashboardSummary {
  enrolledCourseCount: Int!
  activeAssignmentCount: Int!
  pendingActionCount: Int!
  scoreSummary: StudentDashboardScoreSummary!
  generatedAt: String!
}

type StudentDashboardScoreSummary {
  completedAttemptCount: Int!
  attemptedAssignmentCount: Int!
  passedAttemptCount: Int!
  averagePercent: Int!
  bestPercent: Int!
}

type StudentDashboardCourseCard {
  id: String!
  title: String!
  status: String
  progressPercent: Int!
  updatedAt: String
}

type StudentDashboardAssignmentCard {
  id: String!
  quizId: String
  title: String!
  status: String
  dueAt: String
  "Latest handed-in attempt, 0-100; null until one is handed in"
  scorePercent: Float
  submittedAt: String
  subjectName: String
  teacherName: String
  questionCount: Int
  "Assignment time limit in minutes; null when there is none"
  estimatedMinutes: Int
  "PRACTICE or TEST"
  kind: String!
  "Answers saved on the attempt in progress; null when none is open"
  answeredCount: Int
  "Raw score of the latest handed-in attempt and its scale"
  score: Float
  maxScore: Float
  "Correct answers on the latest handed-in attempt; null when none is handed in or it has no graded answers"
  correctCount: Int
  totalQuestions: Int
  attemptCount: Int!
  onTime: Boolean
  minutesBeforeDue: Int
  "XP still earned by handing in now; 0 once handed in"
  xpReward: Int!
  "No late-submission window exists yet: always null"
  lateSubmitUntil: String
  closed: Boolean!
  "The latest attempt is handed in (server state policy); clients must not classify status strings"
  handedIn: Boolean!
}

type StudentDashboardNextAction {
  id: String!
  kind: String!
  label: String!
  targetId: String
  dueAt: String
}

type StudentDashboardAnnouncementCard {
  id: String!
  title: String!
  content: String
  pinned: Boolean!
  publishedAt: String
  updatedAt: String
}

